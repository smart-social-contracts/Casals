{
  "$comment": "Opt-in hello-world demo orchestra (v2). Deploy explicitly: casals up seed/sheets/demo.json -e local",
  "version": 2,
  "name": "demo",
  "description": "Default Casals demo orchestra: hello-world stands per language, each with its own Baton, plus a shared Multisig top commander.",
  "environments": {
    "local": {
      "network": "local",
      "dns": {
        "provider": "none"
      },
      "flags": {
        "test_mode": true,
        "ii_bypass": true
      },
      "principals": {
        "operator": "$deployer"
      },
      "cycles": {
        "min_balance_tc": 0.5,
        "budget_tc": 100
      }
    }
  },
  "conductor": {
    "backend": {
      "wasm": "casals-backend",
      "kind": "backend",
      "mode": "managed",
      "controllers": [
        "$multisig"
      ]
    },
    "frontend": {
      "wasm": "casals-frontend",
      "kind": "frontend",
      "mode": "managed",
      "controllers": [
        "$multisig"
      ]
    },
    "wasms": {
      "$comment": "WASM store: a certified-assets canister holding every artifact Casals installs (issue #48). $deployer stays a controller so `casals up` can upload into it.",
      "wasm": "certified-assets@0.3.0",
      "kind": "frontend",
      "mode": "managed",
      "controllers": ["$self", "$deployer"]
    },
    "commanders": [
      {
        "principal": "$principal:operator",
        "permissions": "*"
      }
    ]
  },
  "governance": {
    "multisig": {
      "wasm": "orchestration-multisig@1.6.0",
      "kind": "backend",
      "mode": "managed",
      "signers": [
        "$principal:operator"
      ],
      "threshold": 1,
      "controllers": [
        "$multisig"
      ]
    }
  },
  "registry": {
    "$comment": "source forms: local:seed/templates/<file> for committed templates; build:<canister> for conductor wasms resolved by the CLI at bootstrap",
    "wasms": [
      {
        "family": "casals-backend",
        "version": "main",
        "source": "build:casals_backend"
      },
      {
        "family": "certified-assets",
        "version": "0.3.0",
        "source": "local:seed/templates/certified-assets@0.3.0.wasm.gz"
      },
      {
        "family": "orchestration-multisig",
        "version": "1.6.0",
        "source": "local:seed/templates/orchestration-multisig@1.6.0.wasm.gz"
      },
      {
        "family": "orchestration-baton",
        "version": "1.3.0",
        "source": "local:seed/templates/orchestration-baton@1.3.0.wasm.gz"
      },
      {
        "family": "hello-world-motoko",
        "version": "1.0.0",
        "source": "local:seed/templates/hello-world-motoko.wasm.gz"
      },
      {
        "family": "hello-world-rust",
        "version": "1.0.0",
        "source": "local:seed/templates/hello-world-rust.wasm.gz"
      },
      {
        "family": "hello-world-basilisk",
        "version": "1.0.0",
        "source": "local:seed/templates/hello-world-basilisk@1.0.0.wasm.gz"
      },
      {
        "family": "hello-world-frontend",
        "version": "1.0.0",
        "source": "local:seed/templates/hello-world-frontend.wasm.gz"
      },
      {
        "family": "hello-world-motoko",
        "version": "1.1.0",
        "source": "local:seed/templates/hello-world-motoko@1.1.0.wasm.gz",
        "sha256": "d79d514b41857546c3da7eba25bae726da647c59633abedc73c036394f59ba03"
      },
      {
        "family": "hello-world-rust",
        "version": "1.1.0",
        "source": "local:seed/templates/hello-world-rust@1.1.0.wasm.gz",
        "sha256": "b03837952de584d44b80d0749913736f356ae3800a3879213268dba7a0c96f9d"
      },
      {
        "family": "hello-world-basilisk",
        "version": "1.4.0",
        "source": "local:seed/templates/hello-world-basilisk@1.4.0.wasm.gz",
        "sha256": "f95e4cd6729ffcc6931b1ac302fe76dee366ffa10c72b50d9bd2688105859063"
      }
    ],
    "publish": [
      {
        "path": "frontend/hello-world/main",
        "source": "local:seed/assets/hello-world"
      }
    ]
  },
  "sections": [
    {
      "name": "Demo",
      "description": "One full-stack stand per backend language; each stand owns a Baton.",
      "stands": [
        {
          "name": "Motoko",
          "description": "Motoko hello-world + Baton + certified-assets frontend.",
          "baton": {
            "commanders": [
              "$self",
              "$stand.backend"
            ],
            "threshold": 2,
            "manages": [
              "backend",
              "frontend"
            ],
            "hand_off": true
          },
          "canisters": [
            {
              "name": "motoko-baton",
              "mode": "managed",
              "kind": "backend",
              "wasm": "orchestration-baton@1.3.0",
              "install_arg": {
                "top_commander": "$self"
              },
              "controllers": [
                "$multisig"
              ]
            },
            {
              "name": "motoko-backend",
              "mode": "managed",
              "kind": "backend",
              "wasm": "hello-world-motoko@1.1.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "method": "set_canister_config_json",
                  "args": {
                    "baton": "$stand.baton"
                  },
                  "converged_when": {
                    "query": "get_canister_config_json",
                    "equals_args": true
                  }
                }
              ]
            },
            {
              "name": "motoko-frontend",
              "mode": "managed",
              "kind": "frontend",
              "wasm": "certified-assets@0.3.0",
              "content": "frontend/hello-world/main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "files": {
                "/canister_ids.js": "globalThis.__CANISTER_IDS={\"backend\":\"$stand.backend\",\"baton\":\"$stand.baton\"};"
              }
            }
          ]
        },
        {
          "name": "Rust",
          "description": "Rust hello-world + Baton + certified-assets frontend.",
          "baton": {
            "commanders": [
              "$self",
              "$stand.backend"
            ],
            "threshold": 2,
            "manages": [
              "backend",
              "frontend"
            ],
            "hand_off": true
          },
          "canisters": [
            {
              "name": "rust-baton",
              "mode": "managed",
              "kind": "backend",
              "wasm": "orchestration-baton@1.3.0",
              "install_arg": {
                "top_commander": "$self"
              },
              "controllers": [
                "$multisig"
              ]
            },
            {
              "name": "rust-backend",
              "mode": "managed",
              "kind": "backend",
              "wasm": "hello-world-rust@1.1.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "method": "set_canister_config_json",
                  "args": {
                    "baton": "$stand.baton"
                  },
                  "converged_when": {
                    "query": "get_canister_config_json",
                    "equals_args": true
                  }
                }
              ]
            },
            {
              "name": "rust-frontend",
              "mode": "managed",
              "kind": "frontend",
              "wasm": "certified-assets@0.3.0",
              "content": "frontend/hello-world/main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "files": {
                "/canister_ids.js": "globalThis.__CANISTER_IDS={\"backend\":\"$stand.backend\",\"baton\":\"$stand.baton\"};"
              }
            }
          ]
        },
        {
          "name": "Python",
          "description": "Basilisk hello-world + Baton + certified-assets frontend.",
          "baton": {
            "commanders": [
              "$self",
              "$stand.backend"
            ],
            "threshold": 2,
            "manages": [
              "backend",
              "frontend"
            ],
            "hand_off": true
          },
          "canisters": [
            {
              "name": "python-baton",
              "mode": "managed",
              "kind": "backend",
              "wasm": "orchestration-baton@1.3.0",
              "install_arg": {
                "top_commander": "$self"
              },
              "controllers": [
                "$multisig"
              ]
            },
            {
              "name": "python-backend",
              "mode": "managed",
              "kind": "backend",
              "wasm": "hello-world-basilisk@1.4.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "method": "set_canister_config_json",
                  "args": {
                    "baton": "$stand.baton"
                  },
                  "converged_when": {
                    "query": "get_canister_config_json",
                    "equals_args": true
                  }
                }
              ]
            },
            {
              "name": "python-frontend",
              "mode": "managed",
              "kind": "frontend",
              "wasm": "certified-assets@0.3.0",
              "content": "frontend/hello-world/main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "files": {
                "/canister_ids.js": "globalThis.__CANISTER_IDS={\"backend\":\"$stand.backend\",\"baton\":\"$stand.baton\"};"
              }
            }
          ]
        }
      ]
    }
  ],
  "cycles": {
    "min_balance_tc": 0.5,
    "top_up_from": "$self",
    "conductor_min_balance_tc": 2.0
  }
}
