{
  "$comment": "Opt-in hello-world demo orchestra (v2). Deploy explicitly: casals up seed/sheets/demo.json -e local",
  "version": 2,
  "name": "demo",
  "description": "Default Casals demo orchestra: hello-world stands per language, each with its own Baton, plus a shared Multisig top commander.",
  "environments": {
    "local": {
      "network": "local",
      "dns": { "provider": "none" },
      "flags": { "test_mode": true, "ii_bypass": true },
      "principals": { "operator": "$deployer" },
      "cycles": { "min_balance_tc": 0.5, "budget_tc": 100 }
    }
  },
  "conductor": {
    "backend": {
      "wasm": "casals-backend",
      "kind": "backend",
      "mode": "managed",
      "controllers": ["$multisig"]
    },
    "frontend": {
      "wasm": "casals-frontend",
      "kind": "frontend",
      "mode": "managed",
      "controllers": ["$multisig"]
    },
    "file_registry": {
      "wasm": "file-registry",
      "kind": "backend",
      "mode": "managed",
      "controllers": ["$self"]
    },
    "file_registry_frontend": {
      "wasm": "file-registry-frontend",
      "kind": "frontend",
      "mode": "managed",
      "controllers": ["$self"]
    }
  },
  "governance": {
    "multisig": {
      "wasm": "orchestration-multisig@1.4.0",
      "kind": "backend",
      "mode": "managed",
      "signers": ["$principal:operator"],
      "threshold": 1,
      "controllers": ["$multisig"]
    }
  },
  "registry": {
    "$comment": "source forms: local:seed/templates/<file> for committed templates; build:<canister> for conductor wasms resolved by the CLI at bootstrap",
    "wasms": [
      { "family": "casals-backend", "version": "main", "source": "build:casals_backend" },
      { "family": "file-registry", "version": "main", "source": "build:ic_file_registry" },
      { "family": "orchestration-multisig", "version": "1.4.0", "source": "local:seed/templates/orchestration-multisig@1.4.0.wasm.gz" },
      { "family": "orchestration-baton", "version": "1.3.0", "source": "local:seed/templates/orchestration-baton@1.3.0.wasm.gz" },
      { "family": "hello-world-motoko", "version": "1.0.0", "source": "local:seed/templates/hello-world-motoko.wasm.gz" },
      { "family": "hello-world-rust", "version": "1.0.0", "source": "local:seed/templates/hello-world-rust.wasm.gz" },
      { "family": "hello-world-basilisk", "version": "1.0.0", "source": "local:seed/templates/hello-world-basilisk@1.0.0.wasm.gz" },
      { "family": "hello-world-frontend", "version": "1.0.0", "source": "local:seed/templates/hello-world-frontend.wasm.gz" }
    ]
  },
  "sections": [
    {
      "name": "Demo",
      "description": "One full-stack stand per backend language; each stand owns a Baton.",
      "stands": [
        {
          "name": "Motoko",
          "description": "Motoko hello-world + Baton + certified-assets frontend.",
          "baton": {
            "wasm": "orchestration-baton@1.3.0",
            "top_commander": "$self",
            "commanders": ["$self", "$stand.backend"],
            "threshold": 2,
            "manages": ["backend", "frontend"],
            "hand_off": true
          },
          "canisters": [
            {
              "name": "motoko-baton",
              "mode": "managed",
              "kind": "backend",
              "wasm": "orchestration-baton@1.3.0",
              "install_arg": { "top_commander": "$multisig" },
              "controllers": ["$multisig", "$self"]
            },
            {
              "name": "motoko-backend",
              "mode": "managed",
              "kind": "backend",
              "wasm": "hello-world-motoko@1.0.0",
              "controllers": ["$self", "$multisig"]
            },
            {
              "name": "motoko-frontend",
              "mode": "managed",
              "kind": "frontend",
              "wasm": "hello-world-frontend@1.0.0",
              "controllers": ["$self", "$multisig"]
            }
          ]
        },
        {
          "name": "Rust",
          "description": "Rust hello-world + Baton + certified-assets frontend.",
          "baton": {
            "wasm": "orchestration-baton@1.3.0",
            "top_commander": "$self",
            "commanders": ["$self", "$stand.backend"],
            "threshold": 2,
            "manages": ["backend", "frontend"],
            "hand_off": true
          },
          "canisters": [
            {
              "name": "rust-baton",
              "mode": "managed",
              "kind": "backend",
              "wasm": "orchestration-baton@1.3.0",
              "install_arg": { "top_commander": "$multisig" },
              "controllers": ["$multisig", "$self"]
            },
            {
              "name": "rust-backend",
              "mode": "managed",
              "kind": "backend",
              "wasm": "hello-world-rust@1.0.0",
              "controllers": ["$self", "$multisig"]
            },
            {
              "name": "rust-frontend",
              "mode": "managed",
              "kind": "frontend",
              "wasm": "hello-world-frontend@1.0.0",
              "controllers": ["$self", "$multisig"]
            }
          ]
        },
        {
          "name": "Python",
          "description": "Basilisk hello-world + Baton + certified-assets frontend.",
          "baton": {
            "wasm": "orchestration-baton@1.3.0",
            "top_commander": "$self",
            "commanders": ["$self", "$stand.backend"],
            "threshold": 2,
            "manages": ["backend", "frontend"],
            "hand_off": true
          },
          "canisters": [
            {
              "name": "python-baton",
              "mode": "managed",
              "kind": "backend",
              "wasm": "orchestration-baton@1.3.0",
              "install_arg": { "top_commander": "$multisig" },
              "controllers": ["$multisig", "$self"]
            },
            {
              "name": "python-backend",
              "mode": "managed",
              "kind": "backend",
              "wasm": "hello-world-basilisk@1.0.0",
              "controllers": ["$self", "$multisig"]
            },
            {
              "name": "python-frontend",
              "mode": "managed",
              "kind": "frontend",
              "wasm": "hello-world-frontend@1.0.0",
              "controllers": ["$self", "$multisig"]
            }
          ]
        }
      ]
    }
  ],
  "cycles": {
    "min_balance_tc": 0.5,
    "top_up_from": "$self",
    "conductor_min_balance_tc": 2.0
  }
}
