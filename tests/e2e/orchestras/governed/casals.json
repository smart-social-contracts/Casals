{
  "version": 2,
  "name": "governed",
  "description": "multisig-controlled conductor, commanders",
  "environments": {
    "local": {
      "network": "local",
      "dns": {
        "provider": "none"
      },
      "flags": {
        "test_mode": true,
        "ii_bypass": true
      },
      "principals": {
        "operator": "$deployer",
        "casals_ii": "$deployer",
        "browser_ii": "kmmq7-cya3t-5a4ag-jee7o-uptix-ordu5-qov4m-yyivk-pm64q-ojhvz-oqe",
        "$comment": "access-code checksums (`casals code new`): whoever redeems the code on the Access Denied dialog (or via claim_commander) takes that commander slot. invited_operator=CASALS-E2E-ACCESS-CODE (used by the access_code e2e scenario; keep it the only slot on Motoko), admin=casals (everything), steward=casals-steward (governance only: sets/applies the sheet and appoints commanders, no canister rights), release_manager=casals-release (deploys, snapshots and reverts across Product; on this env apply goes through the multisig)",
        "invited_operator": "sha256:de5b0cf9529d693d3f371967298ca3841b1b0cdf7a41d8102e45c8f3e5dce688",
        "admin": "sha256:ccadbf8d475e57765abdd4150b80abaa1cf0467e2c79b2f7f4adebc53d9b0e31",
        "steward": "sha256:65fa65e8d3e12282657a11e515874c26e11858802bd9512e2d7c5eef88c5f409",
        "release_manager": "sha256:de2e8fcf679a855ba862c7264278e2c118c5839da20e09f44ce3766acb3f6323"
      },
      "cycles": {
        "min_balance_tc": 0.5,
        "budget_tc": 100
      }
    }
  },
  "conductor": {
    "backend": {
      "wasm": "casals-backend",
      "kind": "backend",
      "mode": "managed",
      "controllers": [
        "$multisig"
      ]
    },
    "frontend": {
      "wasm": "casals-frontend",
      "kind": "frontend",
      "mode": "managed",
      "controllers": [
        "$multisig"
      ]
    },
    "store": {
      "$comment": "WASM store: a certified-assets canister holding every artifact Casals installs (issue #48). $deployer stays a controller so `casals up` can upload into it.",
      "wasm": "certified-assets@0.3.0",
      "kind": "frontend",
      "mode": "managed",
      "controllers": ["$self", "$deployer"]
    },
    "commanders": [
      {
        "principal": "$principal:casals_ii",
        "permissions": "*"
      },
      {
        "principal": "$principal:browser_ii",
        "permissions": "*"
      },
      {
        "principal": "$principal:admin",
        "permissions": "*"
      },
      {
        "principal": "$principal:steward",
        "permissions": "wasm.upload,commander.assign"
      }
    ]
  },
  "governance": {
    "multisig": {
      "wasm": "orchestration-multisig@1.6.0",
      "kind": "backend",
      "mode": "managed",
      "signers": [
        "$principal:operator",
        "$principal:casals_ii",
        "$principal:browser_ii"
      ],
      "threshold": 1,
      "controllers": [
        "$multisig"
      ]
    }
  },
  "registry": {
    "$comment": "source forms: local:seed/templates/<file> for committed templates; build:<canister> for conductor wasms resolved by the CLI at bootstrap",
    "wasms": [
      {
        "family": "casals-backend",
        "version": "main",
        "source": "build:casals_backend"
      },
      {
        "family": "certified-assets",
        "version": "0.3.0",
        "source": "local:seed/templates/certified-assets@0.3.0.wasm.gz"
      },
      {
        "family": "orchestration-multisig",
        "version": "1.6.0",
        "source": "local:seed/templates/orchestration-multisig@1.6.0.wasm.gz"
      },
      {
        "family": "hello-world-motoko",
        "version": "1.0.0",
        "source": "local:seed/templates/hello-world-motoko.wasm.gz"
      }
    ]
  },
  "sections": [
    {
      "name": "Product",
      "description": "Section-level commanders for governed deployments.",
      "commanders": [
        {
          "principal": "$principal:operator",
          "permissions": "canister.*"
        },
        {
          "principal": "$principal:release_manager",
          "permissions": "canister.deploy,canister.snapshot,canister.revert"
        }
      ],
      "stands": [
        {
          "name": "Motoko",
          "commanders": [
            {
              "principal": "$principal:casals_ii",
              "permissions": "stand.*"
            },
            {
              "principal": "$principal:invited_operator",
              "permissions": "canister.lifecycle"
            }
          ],
          "canisters": [
            {
              "name": "motoko-backend",
              "mode": "managed",
              "kind": "backend",
              "wasm": "hello-world-motoko@1.0.0",
              "controllers": [
                "$self",
                "$multisig"
              ]
            }
          ]
        }
      ]
    }
  ],
  "cycles": {
    "min_balance_tc": 0.5,
    "top_up_from": "$self",
    "conductor_min_balance_tc": 2.0
  }
}
