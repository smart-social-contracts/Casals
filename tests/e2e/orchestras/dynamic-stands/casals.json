{
  "version": 2,
  "name": "dynamic-stands",
  "description": "stand_template with runtime-created stands via installer",
  "environments": {
    "local": {
      "network": "local",
      "dns": { "provider": "none" },
      "flags": { "test_mode": true, "ii_bypass": true },
      "principals": {
        "operator": "$deployer",
        "$comment": "access-code slots (`casals code new`): admin=casals (everything), platform_operator=casals-platform (deploys, runs and tops up the installer), realms_operator=casals-realms (creates, renames, deletes and keeps alive the stands the installer mints under Realms)",
        "admin": "sha256:ccadbf8d475e57765abdd4150b80abaa1cf0467e2c79b2f7f4adebc53d9b0e31",
        "platform_operator": "sha256:d36cff64938b358015571bc697b8eb14d311d3be486c3ef7ca57244e795151a6",
        "realms_operator": "sha256:d6606c861e0311482adeac5d701f162d3d7365d612eada47ca9007ebc9d2f27b"
      },
      "cycles": { "min_balance_tc": 0.5, "budget_tc": 100 }
    }
  },
  "conductor": {
    "backend": {
      "wasm": "casals-backend",
      "kind": "backend",
      "mode": "managed",
      "controllers": ["$deployer"]
    },
    "frontend": {
      "wasm": "casals-frontend",
      "kind": "frontend",
      "mode": "managed",
      "controllers": ["$deployer"]
    },
    "file_registry": {
      "wasm": "file-registry",
      "kind": "backend",
      "mode": "managed",
      "controllers": ["$self"]
    },
    "file_registry_frontend": {
      "wasm": "file-registry-frontend",
      "kind": "frontend",
      "mode": "managed",
      "controllers": ["$self"]
    },
    "settings": { "reconcile_interval_secs": 20 },
    "commanders": [
      { "principal": "$principal:admin", "permissions": "*" }
    ]
  },
  "registry": {
    "$comment": "source forms: local:seed/templates/<file> for committed templates; build:<canister> for conductor wasms resolved by the CLI at bootstrap",
    "wasms": [
      { "family": "casals-backend", "version": "main", "source": "build:casals_backend" },
      { "family": "file-registry", "version": "main", "source": "build:ic_file_registry" },
      { "family": "hello-world-basilisk", "version": "1.0.0", "source": "local:seed/templates/hello-world-basilisk@1.0.0.wasm.gz" },
      { "family": "hello-world-rust", "version": "1.0.0", "source": "local:seed/templates/hello-world-rust.wasm.gz" },
      { "family": "hello-world-frontend", "version": "1.0.0", "source": "local:seed/templates/hello-world-frontend.wasm.gz" },
      { "family": "orchestration-baton", "version": "1.3.0", "source": "local:seed/templates/orchestration-baton@1.3.0.wasm.gz" }
    ]
  },
  "sections": [
    {
      "name": "Platform",
      "commanders": [
        { "principal": "$principal:platform_operator", "permissions": "canister.deploy,canister.lifecycle,canister.topup" }
      ],
      "stands": [
        {
          "name": "Installer",
          "canisters": [
            {
              "name": "installer",
              "mode": "managed",
              "kind": "backend",
              "wasm": "hello-world-basilisk@1.0.0",
              "controllers": ["$self", "$deployer"]
            }
          ]
        }
      ]
    },
    {
      "name": "Realms",
      "commanders": [
        { "principal": "$principal:realms_operator", "permissions": "stand.create,stand.rename,stand.delete,canister.lifecycle,canister.topup" }
      ],
      "stand_template": {
        "name_pattern": "realm-*",
        "created_by": "$canister:installer",
        "canisters": [
          {
            "name": "{stand}-baton",
            "mode": "managed",
            "kind": "backend",
            "wasm": "orchestration-baton@1.3.0",
            "install_arg": { "top_commander": "$self" },
            "controllers": ["$deployer"]
          },
          {
            "name": "{stand}-backend",
            "mode": "managed",
            "kind": "backend",
            "wasm": "hello-world-rust@1.0.0",
            "controllers": ["$self", "$deployer"]
          },
          {
            "name": "{stand}-frontend",
            "mode": "managed",
            "kind": "frontend",
            "wasm": "hello-world-frontend@1.0.0",
            "controllers": ["$self", "$deployer"]
          },
          {
            "name": "{stand}-quarter-{n}",
            "mode": "managed",
            "kind": "backend",
            "wasm": "hello-world-rust@1.0.0",
            "optional": true,
            "controllers": ["$self", "$deployer"]
          }
        ],
        "commanders": [{ "principal": "$stand.backend", "permissions": "stand.create" }],
        "baton": {
          "commanders": ["$self", "$stand.backend"],
          "threshold": 2,
          "manages": ["backend", "frontend"],
          "hand_off": true
        }
      }
    }
  ],
  "cycles": {
    "min_balance_tc": 0.5,
    "top_up_from": "$self",
    "conductor_min_balance_tc": 2.0
  }
}
