{
  "version": 2,
  "name": "dynamic-stands",
  "description": "stand_template with runtime-created stands via installer",
  "environments": {
    "local": {
      "network": "local",
      "dns": { "provider": "none" },
      "flags": { "test_mode": true, "ii_bypass": true },
      "principals": {
        "operator": "$deployer",
        "casals_ii": "7mx7e-iesva-6xdkj-yrrrb-bwfyl-qmwmm-unfhg-zi74g-q3oyl-lz42d-dqe",
        "$comment": "access-code slots (`casals code new`): admin=casals (everything), platform_operator=casals-platform (deploys, runs and tops up the installer), realms_operator=casals-realms (creates, renames, deletes and keeps alive the stands the installer mints under Realms)",
        "admin": "sha256:ccadbf8d475e57765abdd4150b80abaa1cf0467e2c79b2f7f4adebc53d9b0e31",
        "platform_operator": "sha256:d36cff64938b358015571bc697b8eb14d311d3be486c3ef7ca57244e795151a6",
        "realms_operator": "sha256:d6606c861e0311482adeac5d701f162d3d7365d612eada47ca9007ebc9d2f27b"
      },
      "cycles": { "min_balance_tc": 0.5, "budget_tc": 100 }
    }
  },
  "conductor": {
    "backend": {
      "wasm": "casals-backend",
      "kind": "backend",
      "mode": "managed",
      "controllers": ["$multisig"]
    },
    "frontend": {
      "wasm": "casals-frontend",
      "kind": "frontend",
      "mode": "managed",
      "controllers": ["$multisig"]
    },
    "wasms": {
      "$comment": "WASM store: a certified-assets canister holding every artifact Casals installs (issue #48). $deployer stays a controller so `casals up` can upload into it.",
      "wasm": "certified-assets@0.3.0",
      "kind": "frontend",
      "mode": "managed",
      "controllers": ["$self", "$deployer"]
    },
    "commanders": [
      { "principal": "$principal:operator", "permissions": "*" },
      { "principal": "$principal:admin", "permissions": "*" }
    ]
  },
  "governance": {
    "multisig": {
      "$comment": "The one key that can reinstall a stand's baton. One signer at threshold 1 on a laptop; staging and production need real signers and a threshold >= 2 for 'the multisig guards the baton' to mean anything.",
      "wasm": "orchestration-multisig@1.6.0",
      "kind": "backend",
      "mode": "managed",
      "signers": ["$principal:operator", "$principal:casals_ii"],
      "threshold": 1,
      "controllers": ["$multisig"]
    }
  },
  "registry": {
    "$comment": "source forms: local:seed/templates/<file> for committed templates; build:<canister> for conductor wasms resolved by the CLI at bootstrap",
    "wasms": [
      { "family": "casals-backend", "version": "main", "source": "build:casals_backend" },
      { "family": "certified-assets", "version": "0.3.0", "source": "local:seed/templates/certified-assets@0.3.0.wasm.gz" },
      { "family": "hello-world-basilisk", "version": "1.0.0", "source": "local:seed/templates/hello-world-basilisk@1.0.0.wasm.gz" },
      { "family": "hello-world-rust", "version": "1.0.0", "source": "local:seed/templates/hello-world-rust.wasm.gz" },
      { "family": "hello-world-frontend", "version": "1.0.0", "source": "local:seed/templates/hello-world-frontend.wasm.gz" },
      { "family": "orchestration-multisig", "version": "1.6.0", "source": "local:seed/templates/orchestration-multisig@1.6.0.wasm.gz" },
      { "family": "orchestration-baton", "version": "1.5.1", "source": "local:seed/templates/orchestration-baton@1.5.1.wasm.gz" }
    ]
  },
  "sections": [
    {
      "name": "Platform",
      "commanders": [
        { "principal": "$principal:platform_operator", "permissions": "canister.deploy,canister.lifecycle,canister.topup" }
      ],
      "stands": [
        {
          "name": "Installer",
          "canisters": [
            {
              "name": "installer",
              "mode": "managed",
              "kind": "backend",
              "wasm": "hello-world-basilisk@1.0.0",
              "controllers": ["$self", "$deployer"]
            }
          ]
        }
      ]
    },
    {
      "name": "Realms",
      "$comment": "Realms are minted by the installer (`create_stand`) and built to completion by the conductor's stand-build timer - the mint is the act. The sheet is applied once by `casals up`; a later template change is shipped with `casals upgrade`, not by re-applying the sheet.",
      "commanders": [
        { "principal": "$principal:realms_operator", "permissions": "stand.create,stand.rename,stand.delete,canister.lifecycle,canister.topup" }
      ],
      "stand_template": {
        "$comment": "Who holds the IC keys of a realm stand once built: the baton is controlled by the multisig only; every member by its baton; a realm (backend and each quarter) also by itself ($this), so it can rewrite its controllers and leave. Casals creates and installs, then hands over and leaves (hand_off sole). Code changes on members are baton proposals: the multisig alone (weight 2) or Casals + the realm capital (1 + 1) reach the threshold.",
        "name_pattern": "realm-*",
        "created_by": "$canister:installer",
        "canisters": [
          {
            "name": "{stand}-baton",
            "mode": "managed",
            "kind": "backend",
            "wasm": "orchestration-baton@1.5.1",
            "install_arg": { "top_commander": "$self" },
            "controllers": ["$multisig"]
          },
          {
            "name": "{stand}-backend",
            "mode": "managed",
            "kind": "backend",
            "wasm": "hello-world-rust@1.0.0",
            "controllers": ["$stand.baton", "$this"]
          },
          {
            "name": "{stand}-frontend",
            "mode": "managed",
            "kind": "frontend",
            "wasm": "hello-world-frontend@1.0.0",
            "controllers": ["$stand.baton"]
          },
          {
            "name": "{stand}-quarter-{n}",
            "mode": "managed",
            "kind": "backend",
            "wasm": "hello-world-rust@1.0.0",
            "optional": true,
            "controllers": ["$stand.baton", "$this"]
          }
        ],
        "commanders": [{ "principal": "$stand.backend", "permissions": "stand.create" }],
        "baton": {
          "commanders": [
            { "principal": "$multisig", "weight": 2 },
            "$self",
            "$stand.backend"
          ],
          "threshold": 2,
          "manages": "*",
          "hand_off": "sole"
        }
      }
    }
  ],
  "cycles": {
    "min_balance_tc": 0.5,
    "top_up_from": "$self",
    "conductor_min_balance_tc": 2.0
  }
}
