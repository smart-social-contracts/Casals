{
  "version": 2,
  "name": "minimal",
  "description": "conductor + one managed backend",
  "environments": {
    "local": {
      "network": "local",
      "dns": { "provider": "none" },
      "flags": { "test_mode": true, "ii_bypass": true },
      "principals": { "operator": "$deployer" },
      "cycles": { "min_balance_tc": 0.5, "budget_tc": 100 }
    }
  },
  "conductor": {
    "backend": {
      "wasm": "casals-backend",
      "kind": "backend",
      "mode": "managed",
      "controllers": ["$deployer"]
    },
    "frontend": {
      "wasm": "casals-frontend",
      "kind": "frontend",
      "mode": "managed",
      "controllers": ["$deployer"]
    },
    "file_registry": {
      "wasm": "file-registry",
      "kind": "backend",
      "mode": "managed",
      "controllers": ["$self"]
    },
    "file_registry_frontend": {
      "wasm": "file-registry-frontend",
      "kind": "frontend",
      "mode": "managed",
      "controllers": ["$self"]
    }
  },
  "registry": {
    "$comment": "source forms: local:seed/templates/<file> for committed templates; build:<canister> for conductor wasms resolved by the CLI at bootstrap",
    "wasms": [
      { "family": "casals-backend", "version": "main", "source": "build:casals_backend" },
      { "family": "file-registry", "version": "main", "source": "build:ic_file_registry" },
      { "family": "hello-world-rust", "version": "1.0.0", "source": "local:seed/templates/hello-world-rust.wasm.gz" }
    ]
  },
  "sections": [
    {
      "name": "App",
      "stands": [
        {
          "name": "Hello",
          "canisters": [
            {
              "name": "hello-backend",
              "mode": "managed",
              "kind": "backend",
              "wasm": "hello-world-rust@1.0.0",
              "controllers": ["$self", "$deployer"]
            }
          ]
        }
      ]
    }
  ],
  "cycles": {
    "min_balance_tc": 0.5,
    "top_up_from": "$self",
    "conductor_min_balance_tc": 2.0
  }
}
