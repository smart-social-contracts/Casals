{
  "version": 2,
  "name": "adopted",
  "description": "adopted backend reconciles control and config only",
  "environments": {
    "local": {
      "network": "local",
      "dns": { "provider": "none" },
      "flags": { "test_mode": true, "ii_bypass": true, "demo_data": false },
      "principals": {
        "operator": "$deployer",
        "$comment": "access-code slots (`casals code new`): admin=casals (everything), external_owner=casals-owner (start/stop, top up, tag — the code itself is deployed outside Casals), auditor=casals-auditor (snapshots and tags on the Adopted stand)",
        "admin": "sha256:ccadbf8d475e57765abdd4150b80abaa1cf0467e2c79b2f7f4adebc53d9b0e31",
        "external_owner": "sha256:2338c757727ad87f8527f871f9dd28af850bf97fb4f496ab94f45913496cd126",
        "auditor": "sha256:fdfb3d345c4403de4f4b536375d4312538a9030850e19098ad6cf4c8a65c2707"
      },
      "$comment": "bindings.external-backend is filled in by the e2e harness after it installs the canister",
      "cycles": { "min_balance_tc": 0.5, "budget_tc": 100 }
    }
  },
  "conductor": {
    "backend": {
      "wasm": "casals-backend",
      "kind": "backend",
      "mode": "managed",
      "controllers": ["$deployer"]
    },
    "frontend": {
      "wasm": "casals-frontend",
      "kind": "frontend",
      "mode": "managed",
      "controllers": ["$deployer"]
    },
    "wasms": {
      "$comment": "WASM store: a certified-assets canister holding every artifact Casals installs (issue #48). $deployer stays a controller so `casals up` can upload into it.",
      "wasm": "certified-assets@0.3.0",
      "kind": "frontend",
      "mode": "managed",
      "controllers": ["$self", "$deployer"]
    },
    "commanders": [
      { "principal": "$principal:admin", "permissions": "*" }
    ]
  },
  "registry": {
    "$comment": "source forms: local:seed/templates/<file> for committed templates; build:<canister> for conductor wasms resolved by the CLI at bootstrap",
    "wasms": [
      { "family": "casals-backend", "version": "main", "source": "build:casals_backend" },
      { "family": "certified-assets", "version": "0.3.0", "source": "local:seed/templates/certified-assets@0.3.0.wasm.gz" },
      { "family": "hello-world-basilisk", "version": "1.3.0", "source": "local:seed/templates/hello-world-basilisk@1.3.0.wasm.gz" }
    ]
  },
  "sections": [
    {
      "name": "External",
      "commanders": [
        { "principal": "$principal:external_owner", "permissions": "canister.lifecycle,canister.topup,canister.tag" }
      ],
      "stands": [
        {
          "name": "Adopted",
          "commanders": [
            { "principal": "$principal:auditor", "permissions": "canister.snapshot,canister.tag" }
          ],
          "canisters": [
            {
              "name": "external-backend",
              "mode": "adopted",
              "kind": "backend",
              "wasm": "hello-world-basilisk@1.3.0",
              "controllers": ["$self", "$deployer"],
              "config": [
                {
                  "method": "set_canister_config_json",
                  "args": { "test_flags": "$env.flags" },
                  "converged_when": { "query": "get_canister_config_json", "equals_args": true }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "cycles": {
    "min_balance_tc": 0.5,
    "top_up_from": "$self",
    "conductor_min_balance_tc": 2.0
  }
}
