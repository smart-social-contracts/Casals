{
  "version": 2,
  "name": "demo",
  "description": "three stands, three batons, shared multisig",
  "environments": {
    "local": {
      "network": "local",
      "dns": {
        "provider": "none"
      },
      "flags": {
        "test_mode": true,
        "ii_bypass": true
      },
      "principals": {
        "operator": "$deployer",
        "$comment": "access-code slots (`casals code new`): admin=casals (everything), release_manager=casals-release (deploys, snapshots and reverts on every Demo stand; upgrades still need each baton's approval), motoko_dev/rust_dev/python_dev=casals-motoko/casals-rust/casals-python (deploy, tag and rename within their own stand only)",
        "admin": "sha256:ccadbf8d475e57765abdd4150b80abaa1cf0467e2c79b2f7f4adebc53d9b0e31",
        "release_manager": "sha256:de2e8fcf679a855ba862c7264278e2c118c5839da20e09f44ce3766acb3f6323",
        "motoko_dev": "sha256:ab18cfe86953fc7ee0f9c5197c081e764465a09d8b0361ffc80b708abb1058a6",
        "rust_dev": "sha256:aaf1b5ae00d2d256e6cf53f77f6807ba608c99defed0a05a7dffb846c5a63947",
        "python_dev": "sha256:1fff220f03f8e6ae51e75fc583fb2948a9447fe2b42b0984e89fe835a5f6a884"
      },
      "cycles": {
        "min_balance_tc": 0.5,
        "budget_tc": 100
      }
    }
  },
  "conductor": {
    "backend": {
      "wasm": "casals-backend",
      "kind": "backend",
      "mode": "managed",
      "controllers": [
        "$multisig"
      ]
    },
    "frontend": {
      "wasm": "casals-frontend",
      "kind": "frontend",
      "mode": "managed",
      "controllers": [
        "$multisig"
      ]
    },
    "wasms": {
      "$comment": "WASM store: a certified-assets canister holding every artifact Casals installs (issue #48). $deployer stays a controller so `casals up` can upload into it.",
      "wasm": "certified-assets@0.3.0",
      "kind": "frontend",
      "mode": "managed",
      "controllers": ["$self", "$deployer"]
    },
    "commanders": [
      {
        "principal": "$principal:operator",
        "permissions": "*"
      },
      {
        "principal": "$principal:admin",
        "permissions": "*"
      }
    ]
  },
  "governance": {
    "multisig": {
      "wasm": "orchestration-multisig@1.6.0",
      "kind": "backend",
      "mode": "managed",
      "signers": [
        "$principal:operator"
      ],
      "threshold": 1,
      "controllers": [
        "$multisig"
      ]
    }
  },
  "registry": {
    "$comment": "source forms: local:seed/templates/<file> for committed templates; build:<canister> for conductor wasms resolved by the CLI at bootstrap",
    "wasms": [
      {
        "family": "casals-backend",
        "version": "main",
        "source": "build:casals_backend"
      },
      {
        "family": "certified-assets",
        "version": "0.3.0",
        "source": "local:seed/templates/certified-assets@0.3.0.wasm.gz"
      },
      {
        "family": "orchestration-multisig",
        "version": "1.6.0",
        "source": "local:seed/templates/orchestration-multisig@1.6.0.wasm.gz"
      },
      {
        "family": "orchestration-baton",
        "version": "1.3.0",
        "source": "local:seed/templates/orchestration-baton@1.3.0.wasm.gz"
      },
      {
        "family": "hello-world-motoko",
        "version": "1.0.0",
        "source": "local:seed/templates/hello-world-motoko.wasm.gz"
      },
      {
        "family": "hello-world-rust",
        "version": "1.0.0",
        "source": "local:seed/templates/hello-world-rust.wasm.gz"
      },
      {
        "family": "hello-world-basilisk",
        "version": "1.0.0",
        "source": "local:seed/templates/hello-world-basilisk@1.0.0.wasm.gz"
      },
      {
        "family": "hello-world-frontend",
        "version": "1.0.0",
        "source": "local:seed/templates/hello-world-frontend.wasm.gz"
      }
    ]
  },
  "sections": [
    {
      "name": "Demo",
      "description": "One full-stack stand per backend language; each stand owns a Baton.",
      "commanders": [
        {
          "principal": "$principal:release_manager",
          "permissions": "canister.deploy,canister.snapshot,canister.revert"
        }
      ],
      "stands": [
        {
          "name": "Motoko",
          "description": "Motoko hello-world + Baton + certified-assets frontend.",
          "commanders": [
            {
              "principal": "$principal:motoko_dev",
              "permissions": "canister.deploy,canister.tag,stand.rename"
            }
          ],
          "baton": {
            "commanders": [
              "$self",
              "$stand.backend"
            ],
            "threshold": 2,
            "manages": [
              "backend",
              "frontend"
            ],
            "hand_off": true
          },
          "canisters": [
            {
              "name": "motoko-baton",
              "mode": "managed",
              "kind": "backend",
              "wasm": "orchestration-baton@1.3.0",
              "install_arg": {
                "top_commander": "$self"
              },
              "controllers": [
                "$multisig"
              ]
            },
            {
              "name": "motoko-backend",
              "mode": "managed",
              "kind": "backend",
              "wasm": "hello-world-motoko@1.0.0",
              "controllers": [
                "$self",
                "$multisig"
              ]
            },
            {
              "name": "motoko-frontend",
              "mode": "managed",
              "kind": "frontend",
              "wasm": "hello-world-frontend@1.0.0",
              "controllers": [
                "$self",
                "$multisig"
              ]
            }
          ]
        },
        {
          "name": "Rust",
          "description": "Rust hello-world + Baton + certified-assets frontend.",
          "commanders": [
            {
              "principal": "$principal:rust_dev",
              "permissions": "canister.deploy,canister.tag,stand.rename"
            }
          ],
          "baton": {
            "commanders": [
              "$self",
              "$stand.backend"
            ],
            "threshold": 2,
            "manages": [
              "backend",
              "frontend"
            ],
            "hand_off": true
          },
          "canisters": [
            {
              "name": "rust-baton",
              "mode": "managed",
              "kind": "backend",
              "wasm": "orchestration-baton@1.3.0",
              "install_arg": {
                "top_commander": "$self"
              },
              "controllers": [
                "$multisig"
              ]
            },
            {
              "name": "rust-backend",
              "mode": "managed",
              "kind": "backend",
              "wasm": "hello-world-rust@1.0.0",
              "controllers": [
                "$self",
                "$multisig"
              ]
            },
            {
              "name": "rust-frontend",
              "mode": "managed",
              "kind": "frontend",
              "wasm": "hello-world-frontend@1.0.0",
              "controllers": [
                "$self",
                "$multisig"
              ]
            }
          ]
        },
        {
          "name": "Python",
          "description": "Basilisk hello-world + Baton + certified-assets frontend.",
          "commanders": [
            {
              "principal": "$principal:python_dev",
              "permissions": "canister.deploy,canister.tag,canister.shell,stand.rename"
            }
          ],
          "baton": {
            "commanders": [
              "$self",
              "$stand.backend"
            ],
            "threshold": 2,
            "manages": [
              "backend",
              "frontend"
            ],
            "hand_off": true
          },
          "canisters": [
            {
              "name": "python-baton",
              "mode": "managed",
              "kind": "backend",
              "wasm": "orchestration-baton@1.3.0",
              "install_arg": {
                "top_commander": "$self"
              },
              "controllers": [
                "$multisig"
              ]
            },
            {
              "name": "python-backend",
              "mode": "managed",
              "kind": "backend",
              "wasm": "hello-world-basilisk@1.0.0",
              "controllers": [
                "$self",
                "$multisig"
              ]
            },
            {
              "name": "python-frontend",
              "mode": "managed",
              "kind": "frontend",
              "wasm": "hello-world-frontend@1.0.0",
              "controllers": [
                "$self",
                "$multisig"
              ]
            }
          ]
        }
      ]
    }
  ],
  "cycles": {
    "min_balance_tc": 0.5,
    "top_up_from": "$self",
    "conductor_min_balance_tc": 2.0
  }
}
