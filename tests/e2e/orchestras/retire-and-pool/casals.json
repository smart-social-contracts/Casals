{
  "version": 2,
  "name": "retire-and-pool",
  "description": "retire: true, pool behaviour, reuse_pool",
  "environments": {
    "local": {
      "network": "local",
      "dns": {
        "provider": "none"
      },
      "flags": {
        "test_mode": true,
        "ii_bypass": true
      },
      "principals": {
        "operator": "$deployer",
        "$comment": "access-code slots (`casals code new`): admin=casals (everything), lifecycle_operator=casals-lifecycle (create, retire/delete, start/stop and top up canisters across the Lifecycle section), stand_owner=casals-owner (rename or delete the Retiring stand)",
        "admin": "sha256:ccadbf8d475e57765abdd4150b80abaa1cf0467e2c79b2f7f4adebc53d9b0e31",
        "lifecycle_operator": "sha256:84675f7c094aff5946321fe9c5ec1764229091cfdbbd12f59fc64fb275d99fbd",
        "stand_owner": "sha256:2338c757727ad87f8527f871f9dd28af850bf97fb4f496ab94f45913496cd126"
      },
      "cycles": {
        "min_balance_tc": 0.5,
        "budget_tc": 100
      }
    }
  },
  "conductor": {
    "backend": {
      "wasm": "casals-backend",
      "kind": "backend",
      "mode": "managed",
      "controllers": [
        "$deployer"
      ]
    },
    "frontend": {
      "wasm": "casals-frontend",
      "kind": "frontend",
      "mode": "managed",
      "controllers": [
        "$deployer"
      ]
    },
    "store": {
      "$comment": "WASM store: a certified-assets canister holding every artifact Casals installs (issue #48). $deployer stays a controller so `casals up` can upload into it.",
      "wasm": "certified-assets@0.3.0",
      "kind": "frontend",
      "mode": "managed",
      "controllers": ["$self", "$deployer"]
    },
    "commanders": [
      {
        "principal": "$principal:admin",
        "permissions": "*"
      }
    ]
  },
  "registry": {
    "$comment": "source forms: local:seed/templates/<file> for committed templates; build:<canister> for conductor wasms resolved by the CLI at bootstrap",
    "wasms": [
      {
        "family": "casals-backend",
        "version": "main",
        "source": "build:casals_backend"
      },
      {
        "family": "certified-assets",
        "version": "0.3.0",
        "source": "local:seed/templates/certified-assets@0.3.0.wasm.gz"
      },
      {
        "family": "hello-world-rust",
        "version": "1.0.0",
        "source": "local:seed/templates/hello-world-rust.wasm.gz"
      }
    ]
  },
  "sections": [
    {
      "name": "Lifecycle",
      "commanders": [
        {
          "principal": "$principal:lifecycle_operator",
          "permissions": "canister.create,canister.delete,canister.lifecycle,canister.topup"
        }
      ],
      "stands": [
        {
          "name": "Retiring",
          "commanders": [
            {
              "principal": "$principal:stand_owner",
              "permissions": "stand.rename,stand.delete"
            }
          ],
          "canisters": [
            {
              "name": "keep-backend",
              "mode": "managed",
              "kind": "backend",
              "wasm": "hello-world-rust@1.0.0",
              "controllers": [
                "$self",
                "$deployer"
              ]
            },
            {
              "name": "old-backend",
              "mode": "managed",
              "kind": "backend",
              "wasm": "hello-world-rust@1.0.0",
              "controllers": [
                "$self",
                "$deployer"
              ],
              "retire": true,
              "allow_destructive": true
            }
          ]
        }
      ]
    }
  ],
  "cycles": {
    "min_balance_tc": 0.5,
    "top_up_from": "$self",
    "conductor_min_balance_tc": 2.0,
    "reuse_pool": true
  }
}
