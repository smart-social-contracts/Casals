{
  "version": 2,
  "name": "baton-stand",
  "description": "one stand with baton: sole hand-off of the backend (controllers = baton), weighted 2-of commanders (multisig alone, or Casals + $stand.backend)",
  "environments": {
    "local": {
      "network": "local",
      "dns": {
        "provider": "none"
      },
      "flags": {
        "test_mode": true,
        "ii_bypass": true
      },
      "principals": {
        "operator": "$deployer",
        "$comment": "access-code slots (`casals code new`): admin=casals (everything), release_manager=casals-release (deploys, snapshots and reverts across Demo; upgrades still need the baton's approval), sre=casals-sre (start/stop and top up the Rust stand)",
        "admin": "sha256:ccadbf8d475e57765abdd4150b80abaa1cf0467e2c79b2f7f4adebc53d9b0e31",
        "release_manager": "sha256:de2e8fcf679a855ba862c7264278e2c118c5839da20e09f44ce3766acb3f6323",
        "sre": "sha256:837a16075a6d801bd8c1065191b64086e2ca7cc6f06049cdde9b120ae7b1b818"
      },
      "cycles": {
        "min_balance_tc": 0.5,
        "budget_tc": 100
      }
    }
  },
  "conductor": {
    "backend": {
      "wasm": "casals-backend",
      "kind": "backend",
      "mode": "managed",
      "controllers": [
        "$multisig"
      ]
    },
    "frontend": {
      "wasm": "casals-frontend",
      "kind": "frontend",
      "mode": "managed",
      "controllers": [
        "$multisig"
      ]
    },
    "store": {
      "$comment": "WASM store: a certified-assets canister holding every artifact Casals installs (issue #48). $deployer stays a controller so `casals up` can upload into it.",
      "wasm": "certified-assets@0.3.0",
      "kind": "frontend",
      "mode": "managed",
      "controllers": ["$self", "$deployer"]
    },
    "commanders": [
      {
        "principal": "$principal:operator",
        "permissions": "*"
      },
      {
        "principal": "$principal:admin",
        "permissions": "*"
      }
    ]
  },
  "governance": {
    "multisig": {
      "wasm": "orchestration-multisig@1.6.0",
      "kind": "backend",
      "mode": "managed",
      "signers": [
        "$principal:operator"
      ],
      "threshold": 1,
      "controllers": [
        "$multisig"
      ]
    }
  },
  "registry": {
    "$comment": "source forms: local:seed/templates/<file> for committed templates; build:<canister> for conductor wasms resolved by the CLI at bootstrap",
    "wasms": [
      {
        "family": "casals-backend",
        "version": "main",
        "source": "build:casals_backend"
      },
      {
        "family": "certified-assets",
        "version": "0.3.0",
        "source": "local:seed/templates/certified-assets@0.3.0.wasm.gz"
      },
      {
        "family": "orchestration-multisig",
        "version": "1.6.0",
        "source": "local:seed/templates/orchestration-multisig@1.6.0.wasm.gz"
      },
      {
        "family": "orchestration-baton",
        "version": "1.5.1",
        "source": "local:seed/templates/orchestration-baton@1.5.1.wasm.gz"
      },
      {
        "family": "hello-world-rust",
        "version": "1.0.0",
        "source": "local:seed/templates/hello-world-rust.wasm.gz"
      },
      {
        "family": "hello-world-frontend",
        "version": "1.0.0",
        "source": "local:seed/templates/hello-world-frontend.wasm.gz"
      }
    ],
    "bundles": [
      {
        "path": "frontend/rust-frontend/1.0.0",
        "source": "local:dist"
      }
    ]
  },
  "sections": [
    {
      "name": "Demo",
      "commanders": [
        {
          "principal": "$principal:release_manager",
          "permissions": "canister.deploy,canister.snapshot,canister.revert"
        }
      ],
      "stands": [
        {
          "name": "Rust",
          "commanders": [
            {
              "principal": "$principal:sre",
              "permissions": "canister.lifecycle,canister.topup"
            }
          ],
          "baton": {
            "$comment": "The frontend keeps Casals as a controller: Casals writes its assets (content/files). Sole hand-off covers the backend; the multisig (weight 2) can approve alone, Casals and the backend (1 each) together.",
            "commanders": [
              {
                "principal": "$multisig",
                "weight": 2
              },
              "$self",
              "$stand.backend"
            ],
            "threshold": 2,
            "manages": [
              "backend"
            ],
            "hand_off": "sole"
          },
          "canisters": [
            {
              "name": "rust-baton",
              "mode": "managed",
              "kind": "backend",
              "wasm": "orchestration-baton@1.5.1",
              "install_arg": {
                "top_commander": "$self"
              },
              "controllers": [
                "$multisig"
              ]
            },
            {
              "name": "rust-backend",
              "mode": "managed",
              "kind": "backend",
              "wasm": "hello-world-rust@1.0.0",
              "controllers": [
                "$stand.baton"
              ]
            },
            {
              "name": "rust-frontend",
              "mode": "managed",
              "kind": "frontend",
              "wasm": "hello-world-frontend@1.0.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "content": "frontend/rust-frontend/1.0.0",
              "files": {
                "/canister_ids.js": "globalThis.__CANISTER_IDS = {\"backend\": \"$stand.backend\"};\n"
              },
              "health": [
                {
                  "http": "/index.html",
                  "status": 200
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "cycles": {
    "min_balance_tc": 0.5,
    "top_up_from": "$self",
    "conductor_min_balance_tc": 2.0
  }
}
