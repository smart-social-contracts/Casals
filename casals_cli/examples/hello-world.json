{
  "version": 2,
  "name": "hello-world",
  "description": "a Basilisk backend and a hello-world frontend, installed from Casals release {release}",
  "environments": {
    "local": {
      "network": "local",
      "dns": { "provider": "none" },
      "principals": {
        "operator": "$deployer",
        "$comment": "access-code slot (`casals code new`); redeem it on the Access Denied dialog: admin=casals",
        "admin": "sha256:ccadbf8d475e57765abdd4150b80abaa1cf0467e2c79b2f7f4adebc53d9b0e31"
      },
      "cycles": { "min_balance_tc": 0.5, "budget_tc": 100 }
    }
  },
  "conductor": {
    "backend": {
      "wasm": "casals-backend",
      "kind": "backend",
      "mode": "managed",
      "controllers": ["$deployer"]
    },
    "frontend": {
      "wasm": "casals-frontend",
      "kind": "frontend",
      "mode": "managed",
      "content": "frontend/casals-ui/main",
      "controllers": ["$self", "$deployer"]
    },
    "store": {
      "$comment": "WASM store: a certified-assets canister holding every artifact Casals installs. $deployer stays a controller so `casals up` can upload into it.",
      "wasm": "certified-assets@0.3.0",
      "kind": "frontend",
      "mode": "managed",
      "controllers": ["$self", "$deployer"]
    },
    "commanders": [
      { "principal": "$principal:admin", "permissions": "*" }
    ]
  },
  "registry": {
    "$comment": "the conductor, its store and its UI come from the Casals GitHub release; the hello-world canisters are the files committed at that tag",
    "wasms": [
      { "family": "casals-backend", "version": "main", "source": "release:smart-social-contracts/Casals@{release}:casals_backend.wasm.gz" },
      { "family": "certified-assets", "version": "0.3.0", "source": "release:smart-social-contracts/Casals@{release}:certified-assets@0.3.0.wasm.gz" },
      { "family": "hello-world-basilisk", "version": "1.0.0", "source": "https://raw.githubusercontent.com/smart-social-contracts/Casals/{release}/seed/templates/hello-world-basilisk@1.0.0.wasm.gz" },
      { "family": "hello-world-frontend", "version": "1.0.0", "source": "https://raw.githubusercontent.com/smart-social-contracts/Casals/{release}/seed/templates/hello-world-frontend.wasm.gz" }
    ],
    "bundles": [
      { "path": "frontend/casals-ui/main", "source": "release:smart-social-contracts/Casals@{release}:casals_frontend.tar.gz" }
    ]
  },
  "sections": [
    {
      "name": "Hello",
      "stands": [
        {
          "name": "App",
          "canisters": [
            {
              "name": "backend",
              "mode": "managed",
              "kind": "backend",
              "wasm": "hello-world-basilisk@1.0.0",
              "controllers": ["$self", "$deployer"]
            },
            {
              "name": "frontend",
              "mode": "managed",
              "kind": "frontend",
              "wasm": "hello-world-frontend@1.0.0",
              "controllers": ["$self", "$deployer"]
            }
          ]
        }
      ]
    }
  ],
  "cycles": {
    "min_balance_tc": 0.5,
    "conductor_min_balance_tc": 2.0
  }
}
