{
  "version": 2,
  "name": "minimal",
  "description": "conductor + one managed backend, installed from Casals release {release}",
  "environments": {
    "local": {
      "network": "local",
      "dns": { "provider": "none" },
      "principals": {
        "operator": "$deployer",
        "$comment": "access-code slots (`casals code new`); redeem the code on the Access Denied dialog. Every slot uses the code casals, so one claim takes them all: admin (everything), app_operator (runs the App section), hello_dev (ships the Hello stand)",
        "admin": "sha256:ccadbf8d475e57765abdd4150b80abaa1cf0467e2c79b2f7f4adebc53d9b0e31",
        "app_operator": "sha256:ccadbf8d475e57765abdd4150b80abaa1cf0467e2c79b2f7f4adebc53d9b0e31",
        "hello_dev": "sha256:ccadbf8d475e57765abdd4150b80abaa1cf0467e2c79b2f7f4adebc53d9b0e31"
      },
      "cycles": { "min_balance_tc": 0.5, "budget_tc": 100 }
    }
  },
  "conductor": {
    "backend": {
      "wasm": "casals-backend",
      "kind": "backend",
      "mode": "managed",
      "controllers": ["$deployer"]
    },
    "frontend": {
      "wasm": "casals-frontend",
      "kind": "frontend",
      "mode": "managed",
      "content": "frontend/casals-ui/main",
      "controllers": ["$self", "$deployer"]
    },
    "store": {
      "$comment": "WASM store: a certified-assets canister holding every artifact Casals installs. $deployer stays a controller so `casals up` can upload into it.",
      "wasm": "certified-assets@0.3.0",
      "kind": "frontend",
      "mode": "managed",
      "controllers": ["$self", "$deployer"]
    },
    "commanders": [
      { "principal": "$principal:admin", "permissions": "*" }
    ]
  },
  "registry": {
    "$comment": "the conductor, its store and its UI come from the Casals GitHub release; the hello-world template is the file committed at that tag",
    "wasms": [
      { "family": "casals-backend", "version": "main", "source": "release:smart-social-contracts/Casals@{release}:casals_backend.wasm.gz" },
      { "family": "certified-assets", "version": "0.3.0", "source": "release:smart-social-contracts/Casals@{release}:certified-assets@0.3.0.wasm.gz" },
      { "family": "hello-world-rust", "version": "1.0.0", "source": "https://raw.githubusercontent.com/smart-social-contracts/Casals/{release}/seed/templates/hello-world-rust.wasm.gz" }
    ],
    "bundles": [
      { "path": "frontend/casals-ui/main", "source": "release:smart-social-contracts/Casals@{release}:casals_frontend.tar.gz" }
    ]
  },
  "sections": [
    {
      "name": "App",
      "commanders": [
        { "principal": "$principal:app_operator", "permissions": "canister.deploy,canister.lifecycle,canister.topup,canister.snapshot,canister.revert" }
      ],
      "stands": [
        {
          "name": "Hello",
          "commanders": [
            { "principal": "$principal:hello_dev", "permissions": "canister.deploy,canister.tag" }
          ],
          "canisters": [
            {
              "name": "hello-backend",
              "mode": "managed",
              "kind": "backend",
              "wasm": "hello-world-rust@1.0.0",
              "controllers": ["$self", "$deployer"]
            }
          ]
        }
      ]
    }
  ],
  "cycles": {
    "min_balance_tc": 0.5,
    "conductor_min_balance_tc": 2.0
  }
}
